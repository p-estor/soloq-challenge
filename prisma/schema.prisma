generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id            String       @id @default(uuid())
  gameName      String
  tagLine       String
  alias         String?
  puuid         String       @unique
  summonerId    String?      @unique
  profileIconId Int          @default(0)
  isHighElo     Boolean      @default(false)
  tier          String       @default("UNRANKED")
  rank          String       @default("")
  leaguePoints  Int          @default(0)
  wins          Int          @default(0)
  losses        Int          @default(0)
  streak        Int          @default(0)
  startTier     String       @default("UNRANKED")
  startRank     String       @default("")
  startLp       Int          @default(0)
  lastUpdated   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  mainGameName  String?
  mainLp        Int?
  mainRank      String?
  mainTagLine   String?
  mainTier      String?
  snapshots     LPSnapshot[]
  matches       Match[]
}

model LPSnapshot {
  id           String   @id @default(uuid())
  playerId     String
  tier         String
  rank         String
  leaguePoints Int
  globalLp     Int
  timestamp    DateTime @default(now())
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Match {
  id                      String   @id @default(uuid())
  matchId                 String
  playerId                String
  championId              Int
  championName            String
  win                     Boolean
  kills                   Int
  deaths                  Int
  assists                 Int
  cs                      Int
  gameDuration            Int
  gameCreation            DateTime
  queueId                 Int
  isRemake                Boolean  @default(false)
  pentaKills              Int      @default(0)
  objectivesStolen        Int      @default(0)
  enemyJungleMonsterKills Int      @default(0)
  visionScore             Int      @default(0)
  wardsKilled             Int      @default(0)
  createdAt               DateTime @default(now())
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
}

model Settings {
  key   String @id
  value String
}
